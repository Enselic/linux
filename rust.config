# Broad Rust build coverage. Use with KCONFIG_ALLCONFIG and allmodconfig.
# Kconfig may drop options whose architecture or toolchain dependencies are unmet.
# This enables experimental drivers, benchmarks, KUnit tests, and KASAN.

CONFIG_COMPILE_TEST=y
CONFIG_MODULES=y
CONFIG_RUST=y

# Subsystems used by Rust abstractions, drivers, and samples.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_CONFIGFS_FS=y
CONFIG_CPU_FREQ=y
CONFIG_DEBUG_FS=y
# DRM must be built in for the Rust DRM abstractions and drivers.
CONFIG_AGP=y
CONFIG_DRM=y
CONFIG_DRM_PANIC=y
CONFIG_DRM_VKMS=m
CONFIG_FWCTL=y
CONFIG_I2C=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_PCI=y
CONFIG_PHYLIB=y
CONFIG_PWM=y
CONFIG_USB=y

# Rust abstractions with user-visible switches.
CONFIG_RUST_FW_LOADER_ABSTRACTIONS=y
CONFIG_RUST_FWCTL_ABSTRACTIONS=y
CONFIG_RUST_PHYLIB_ABSTRACTIONS=y

# Rust drivers and other Rust build targets.
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_BLK_DEV_RUST_NULL=m
CONFIG_CPUFREQ_DT_RUST=m
CONFIG_DRM_NOVA=m
CONFIG_NOVA_CORE_SELFTESTS=y
CONFIG_DRM_TYR=m
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y
CONFIG_AMCC_QT2025_PHY=m
CONFIG_AX88796B_PHY=m
CONFIG_AX88796B_RUST_PHY=y
CONFIG_PWM_TH1520=m
CONFIG_FIND_BIT_BENCHMARK_RUST=m

# Rust samples, including host programs.
CONFIG_SAMPLES=y
CONFIG_SAMPLES_RUST=y
CONFIG_SAMPLE_RUST_CONFIGFS=m
CONFIG_SAMPLE_RUST_MINIMAL=m
CONFIG_SAMPLE_RUST_MISC_DEVICE=m
CONFIG_SAMPLE_RUST_PRINT=m
CONFIG_SAMPLE_RUST_DMA=m
CONFIG_SAMPLE_RUST_DEBUGFS=m
CONFIG_SAMPLE_RUST_DEBUGFS_SCOPED=m
CONFIG_SAMPLE_RUST_DRIVER_I2C=m
CONFIG_SAMPLE_RUST_I2C_CLIENT=m
CONFIG_SAMPLE_RUST_DRIVER_PCI=m
CONFIG_SAMPLE_RUST_DRIVER_PLATFORM=m
CONFIG_SAMPLE_RUST_DRIVER_USB=m
CONFIG_SAMPLE_RUST_DRIVER_FAUX=m
CONFIG_SAMPLE_RUST_DRIVER_AUXILIARY=m
CONFIG_SAMPLE_RUST_DRIVER_SERDEV=m
CONFIG_SAMPLE_RUST_SOC=m
CONFIG_SAMPLE_RUST_HOSTPROGS=y

# Rust unit tests, doctests, and the Rust KASAN tests.
CONFIG_KUNIT=y
CONFIG_RUST_KUNIT_TESTS=y
CONFIG_RUST_ALLOCATOR_KUNIT_TEST=y
CONFIG_RUST_KVEC_KUNIT_TEST=y
CONFIG_RUST_BITMAP_KUNIT_TEST=y
CONFIG_RUST_KUNIT_SELFTEST=y
CONFIG_RUST_STR_KUNIT_TEST=y
CONFIG_RUST_ATOMICS_KUNIT_TEST=y
CONFIG_RUST_BITFIELD_KUNIT_TEST=y
CONFIG_RUST_BUG_KUNIT_TEST=y
CONFIG_RUST_TIME_KUNIT_TEST=y
CONFIG_RUST_KERNEL_DOCTESTS=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_KUNIT_TEST=m
